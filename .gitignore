__pycache__/
*.py[cod]
*.egg-info/

# Local run outputs.
logs/

/checkpoints/

# RLinf is consumed as an external checkout, not vendored here.
/rlinf/
/rlinf.egg-info/

/memory/
/resources/

uv.lock

# Documentation build artifacts and local environment.
.docs-venv/
docs/build/

build/
.claude/settings.json
.venv/
/.codex-rpent-live/

# Standalone calibration environment.
.venv-calibration/

# pick_place data: only corpus.jsonl, fixtures.json and the metrics are committed
robots/mujoco_lab/data/*
!robots/mujoco_lab/data/corpus*.jsonl
!robots/mujoco_lab/data/probe_corpus*.jsonl
!robots/mujoco_lab/data/*.json
# the milestone 2 bundle: the manifest and the metrics are committed, the models stay local
!robots/mujoco_lab/data/m2/
robots/mujoco_lab/data/m2/*
!robots/mujoco_lab/data/m2/*.json
# the milestone 2b bundle and its folds: the manifests, the metrics and the checks; the models stay local
!robots/mujoco_lab/data/m2b/
robots/mujoco_lab/data/m2b/*
!robots/mujoco_lab/data/m2b/*.json
!robots/mujoco_lab/data/m2b/folds/
robots/mujoco_lab/data/m2b/folds/*
!robots/mujoco_lab/data/m2b/folds/*.json
!robots/mujoco_lab/data/m2b/folds/fold_*/
robots/mujoco_lab/data/m2b/folds/fold_*/*
!robots/mujoco_lab/data/m2b/folds/fold_*/*.json
